<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Patika.App.ViewModels.Account"
             x:Class="Patika.App.Pages.Account.SignInPage"
             x:DataType="vm:SignInViewModel"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Kar}"
             Title="Giriş">
    <ContentPage.Resources>
        <Style x:Key="PrimaryAction" TargetType="Button">
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="FontSize" Value="19" />
        </Style>
        <Style x:Key="OutlineAction" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="FontSize" Value="18" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout>
            <Grid BackgroundColor="{StaticResource Tekir}" HeightRequest="236" Padding="24,28">
                <Image Source="patika_mark.png" HeightRequest="120" WidthRequest="120" HorizontalOptions="End" VerticalOptions="Start" Opacity="0.9"
                       SemanticProperties.Description="Patika" />
                <VerticalStackLayout VerticalOptions="End" Spacing="6">
                    <Label Text="patika" FontFamily="NunitoExtraBold" FontSize="44" LineHeight="1" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Mahallenin patilerini birlikte koruyalım." FontFamily="NunitoSansBold" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="24" Spacing="14">
                <Border Style="{StaticResource Panel}" Padding="16" IsVisible="{Binding HasNotice}" BackgroundColor="{StaticResource TekirSoft}">
                    <Label Text="{Binding Notice}" FontFamily="NunitoSansSemiBold" />
                </Border>
                <VerticalStackLayout Spacing="6">
                    <Label Text="E-posta" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding Email}" Keyboard="Email" AutomationId="EmailEntry" Placeholder="ornek@eposta.com"
                               SemanticProperties.Description="E-posta" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Şifre" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding Password}" IsPassword="True" AutomationId="PasswordEntry" SemanticProperties.Description="Şifre"
                               ReturnCommand="{Binding SignInCommand}" />
                    </Border>
                </VerticalStackLayout>
                <Button Text="Şifremi unuttum" Style="{StaticResource LinkButton}" HorizontalOptions="End" FontSize="15"
                        Command="{Binding ForgotPasswordCommand}" AutomationId="ForgotLink" />
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                <Button Text="Giriş yap" Style="{StaticResource PrimaryAction}" Command="{Binding SignInCommand}" IsEnabled="{Binding IsNotBusy}"
                        AutomationId="SignInButton" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource TekirDeep}" />
                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                    <BoxView HeightRequest="1" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="ya da" Style="{StaticResource Muted}" />
                    <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center" />
                </Grid>
                <Button Text="Google ile devam et" Style="{StaticResource OutlineAction}" Command="{Binding GoogleCommand}" IsEnabled="{Binding IsNotBusy}"
                        AutomationId="GoogleButton" />
                <VerticalStackLayout Spacing="2" Margin="0,16,0,0">
                    <Button Text="Hesabın yok mu? Kayıt ol" Style="{StaticResource LinkButton}" Command="{Binding SignUpCommand}" AutomationId="SignUpLink" />
                    <Button Text="Giriş yapmadan haritaya bak" Style="{StaticResource LinkButton}" Command="{Binding BrowseAsGuestCommand}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
