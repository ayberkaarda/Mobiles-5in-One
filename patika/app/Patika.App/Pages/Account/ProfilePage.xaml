<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Patika.App.ViewModels.Account"
             x:Class="Patika.App.Pages.Account.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profil">
    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,32" Spacing="24">
            <HorizontalStackLayout Spacing="14">
                <Border BackgroundColor="{StaticResource TekirSoft}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="64" HeightRequest="64">
                    <Image Source="patika_mark.png" WidthRequest="38" HeightRequest="38" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding DisplayName}" SemanticProperties.HeadingLevel="Level1" Style="{StaticResource Display}" />
                        <Label Style="{StaticResource Sample}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Moda gönüllüsü, Mart 2026’dan beri" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Border Style="{StaticResource Panel}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                    <VerticalStackLayout>
                        <Label Text="128" Style="{StaticResource Count}" />
                        <Label Text="besleme" Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="4" Style="{StaticResource Count}" TextColor="{StaticResource NaneDeep}" />
                        <Label Text="istasyona bakıyor" Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="10">
                <Label Text="Rozetler" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Title}" />
                <FlexLayout Wrap="Wrap" JustifyContent="Start">
                    <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource TekirSoft}" Margin="0,0,8,8">
                        <Label Style="{StaticResource ChipLabel}" Text="Sabah turu" TextColor="{StaticResource TekirDeep}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource NaneSoft}" Margin="0,0,8,8">
                        <Label Style="{StaticResource ChipLabel}" Text="Su taşıyıcı" TextColor="{StaticResource NaneDeep}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" BackgroundColor="{StaticResource Kum}" Margin="0,0,8,8">
                        <Label Style="{StaticResource ChipLabel}" Text="İlk istasyon" />
                    </Border>
                </FlexLayout>
                <Label Text="Sıralama yok. Rozetler yalnızca senin için." Style="{StaticResource Muted}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Panel}" BackgroundColor="{StaticResource NaneSoft}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Konumun sende kalır" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Title}" TextColor="{StaticResource NaneDeep}" />
                    <Label Text="Patika konumunu profilinde saklamaz. İstasyon eklerken ya da acil çağrı açarken yalnızca o an kullanılır." />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{StaticResource AcilDeep}" />
            <Button Text="Çıkış yap" Style="{StaticResource QuietButton}" HorizontalOptions="Start"
                    Command="{Binding SignOutCommand}" AutomationId="SignOutButton" />
            <Button Text="Hesabımı sil" Style="{StaticResource QuietButton}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
