<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Patika.App.ViewModels.Account"
             xmlns:local="clr-namespace:Patika.App.Pages.Account"
             x:Class="Patika.App.Pages.Account.ResetPasswordPage"
             x:DataType="vm:ResetPasswordViewModel"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Kar}"
             Title="Şifreni yenile">
    <Grid RowDefinitions="Auto,*,Auto">
        <local:PageHeader Title="Şifreni yenile" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,16,24,24" Spacing="14">
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Email}" FontFamily="NunitoSansBold" />
                            <Span Text=" adresine gelen 6 haneli kodu ve yeni şifreni yaz." />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <Label Text="Kod" Style="{StaticResource FieldLabel}" />
                <local:CodeBoxes />
                <VerticalStackLayout Spacing="6">
                    <Label Text="Yeni şifre" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding NewPassword}" IsPassword="True" AutomationId="NewPasswordEntry"
                               SemanticProperties.Description="Yeni şifre, en az 10 karakter" ReturnCommand="{Binding ResetCommand}" />
                    </Border>
                    <Label Text="En az 10 karakter. Şifre değişince açık oturumların kapanır." Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <Label Text="{Binding Notice}" IsVisible="{Binding HasNotice}" FontFamily="NunitoSansSemiBold" TextColor="{StaticResource NaneDeep}" />
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                <Button Text="{Binding ResendLabel}" Style="{StaticResource QuietButton}" BorderWidth="1" BorderColor="{StaticResource Sis}"
                        HorizontalOptions="Start" HeightRequest="44" CornerRadius="22" FontFamily="NunitoSansBold" FontSize="15"
                        Command="{Binding ResendCommand}" IsEnabled="{Binding CanResend}" />
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Padding="24,0,24,24" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource TekirDeep}" />
            <Button Text="Şifreyi değiştir" HeightRequest="56" CornerRadius="28" FontSize="19" Command="{Binding ResetCommand}"
                    IsEnabled="{Binding IsNotBusy}" AutomationId="ResetButton" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
