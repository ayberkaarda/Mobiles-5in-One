<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Patika.App.ViewModels.Account"
             xmlns:local="clr-namespace:Patika.App.Pages.Account"
             x:Class="Patika.App.Pages.Account.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Kar}"
             Title="Şifremi unuttum">
    <Grid RowDefinitions="Auto,*">
        <local:PageHeader Title="Şifremi unuttum" />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="14">
                <Label Text="E-postanı yaz; şifreni yenilemen için 6 haneli bir kod gönderelim. Kod 15 dakika geçerli."
                       Style="{StaticResource Lede}" />
                <VerticalStackLayout Spacing="6">
                    <Label Text="E-posta" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource Field}">
                        <Entry Text="{Binding Email}" Keyboard="Email" AutomationId="EmailEntry" SemanticProperties.Description="E-posta"
                               ReturnCommand="{Binding SendCommand}" />
                    </Border>
                </VerticalStackLayout>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorText}" />
                <Button Text="Kod gönder" HeightRequest="56" CornerRadius="28" FontSize="19" Command="{Binding SendCommand}"
                        IsEnabled="{Binding IsNotBusy}" AutomationId="SendCodeButton" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource TekirDeep}" />
                <Label Text="Bu adresle bir hesap yoksa e-posta gelmez; güvenliğin için bunu burada söylemiyoruz." Style="{StaticResource Muted}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
