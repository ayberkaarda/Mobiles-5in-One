<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Patika.App.Pages.Urgent.UrgentPage"
             Title="Acil"
             BackgroundColor="{StaticResource Kaldirim}">
    <ScrollView>
        <VerticalStackLayout Padding="20,28,20,32" Spacing="24">
            <VerticalStackLayout Spacing="8">
                <Label Text="Yaralı bir hayvan mı buldun?" SemanticProperties.HeadingLevel="Level1" Style="{StaticResource Display}" TextColor="{StaticResource Kar}" />
                <Label Text="Çağrın 2 km içindeki gönüllülere gider. Konumun yalnızca bu çağrı için kullanılır, profilinde saklanmaz." TextColor="{StaticResource Cizgi}" />
            </VerticalStackLayout>

            <Button Text="Acil yardım çağrısı aç" Style="{StaticResource UrgentButton}" />

            <Grid ColumnDefinitions="40,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="18">
                <Border BackgroundColor="{StaticResource AcilDeep}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="36" HeightRequest="36" VerticalOptions="Start">
                    <Label Text="1" FontFamily="NunitoExtraBold" TextColor="{StaticResource Beyaz}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Mesafeni koru." Style="{StaticResource Title}" TextColor="{StaticResource Kar}" />
                    <Label Text="Korkmuş bir hayvan ısırabilir; önce sakinleşmesini bekle." TextColor="{StaticResource Cizgi}" />
                </VerticalStackLayout>
                <Border Grid.Row="1" BackgroundColor="{StaticResource AcilDeep}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="36" HeightRequest="36" VerticalOptions="Start">
                    <Label Text="2" FontFamily="NunitoExtraBold" TextColor="{StaticResource Beyaz}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                    <Label Text="Bir fotoğraf ve kısa not." Style="{StaticResource Title}" TextColor="{StaticResource Kar}" />
                    <Label Text="Fotoğrafın konum bilgisi telefonda silinir." TextColor="{StaticResource Cizgi}" />
                </VerticalStackLayout>
                <Border Grid.Row="2" BackgroundColor="{StaticResource AcilDeep}" StrokeThickness="0" StrokeShape="Ellipse" WidthRequest="36" HeightRequest="36" VerticalOptions="Start">
                    <Label Text="3" FontFamily="NunitoExtraBold" TextColor="{StaticResource Beyaz}" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                    <Label Text="En yakın açık veterinere ulaş." Style="{StaticResource Title}" TextColor="{StaticResource Kar}" />
                    <Label Text="Liste mesafeye göre sıralı." TextColor="{StaticResource Cizgi}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="0">
                <HorizontalStackLayout Spacing="8" Margin="0,0,0,8">
                    <Label Text="Yakındaki bakım yerleri" SemanticProperties.HeadingLevel="Level2" Style="{StaticResource Title}" TextColor="{StaticResource Kar}" />
                    <Label Style="{StaticResource Sample}" TextColor="{StaticResource SisLight}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <BoxView HeightRequest="1" Color="{StaticResource KaldirimSoft}" />
                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <VerticalStackLayout>
                        <Label Text="Kuşdili Veteriner Kliniği" FontFamily="NunitoSansBold" TextColor="{StaticResource Kar}" />
                        <Label Text="24 saat açık" FontFamily="NunitoSansBold" FontSize="{StaticResource FontSizeSmall}" TextColor="{StaticResource Nane}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="650 m" TextColor="{StaticResource Cizgi}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource KaldirimSoft}" />
                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <Label Text="Mahalle Geçici Bakımevi" FontFamily="NunitoSansBold" TextColor="{StaticResource Kar}" />
                    <Label Grid.Column="1" Text="2,1 km" TextColor="{StaticResource Cizgi}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{StaticResource KaldirimSoft}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
