<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Patika.App.ViewModels.Stations"
             x:Class="Patika.App.Pages.Stations.FeedingDonePage"
             x:DataType="vm:FeedingDoneViewModel"
             BackgroundColor="{StaticResource Kum}"
             Title="Beslendi">
    <Grid RowDefinitions="*,Auto">
        <!-- The green check of a fed station, large, where the map was; Tekir while it waits on the phone. -->
        <Grid HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="120" HeightRequest="120">
            <Ellipse Fill="{StaticResource NaneSoft}" />
            <Ellipse Fill="{StaticResource NaneDeep}" WidthRequest="72" HeightRequest="72" HorizontalOptions="Center" VerticalOptions="Center">
                <Ellipse.Triggers>
                    <DataTrigger TargetType="Ellipse" Binding="{Binding Queued}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource TekirDeep}" />
                    </DataTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Label Text="✓" FontSize="40" FontFamily="NunitoExtraBold" TextColor="{StaticResource Beyaz}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Sheet}" Padding="24,12,24,24" StrokeThickness="0">
            <VerticalStackLayout Spacing="8">
                <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2" HorizontalOptions="Center" Margin="0,0,0,14" />
                <Label Text="{Binding Heading}" FontFamily="NunitoExtraBold" FontSize="30" LineHeight="1.1"
                       SemanticProperties.HeadingLevel="Level1" AutomationId="FedHeading" />
                <Label Text="{Binding Body}" LineHeight="1.4" />
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="6" Margin="0,10,0,0">
                    <Label Text="Kaydedildi" Style="{StaticResource Muted}" />
                    <Label Grid.Column="1" Text="{Binding RecordedAt}" FontFamily="NunitoSansBold" FontSize="{StaticResource FontSizeSmall}" AutomationId="FedRecordedAt" />
                    <Label Grid.Row="1" Text="Tekrar" Style="{StaticResource Muted}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Again}" FontFamily="NunitoSansBold" FontSize="{StaticResource FontSizeSmall}" AutomationId="FedAgain" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,16,0,0">
                    <Button Text="Haritaya dön" FontSize="18" Command="{Binding ToMapCommand}" AutomationId="FedToMap" />
                    <Button Grid.Column="1" Text="İstasyona dön" Style="{StaticResource QuietButton}" FontSize="18" Command="{Binding ToStationCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
