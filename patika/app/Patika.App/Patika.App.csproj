<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Patika.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ApplicationTitle>Patika</ApplicationTitle>
    <ApplicationId>app.patika.android</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <NeutralLanguage>tr-TR</NeutralLanguage>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon, splash and colors come from patika/brand (tokens.json and app-icon/*.svg). -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.6" Color="#F28C28" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F28C28" BaseSize="160,160" />
    <MauiImage Include="Resources\Images\*.svg" />
    <MauiFont Include="Resources\Fonts\*.ttf" />
    <!-- SIL OFL 1.1: the license text ships inside the app with the bundled fonts. -->
    <MauiAsset Include="Resources\Fonts\licenses\*.txt" LogicalName="licenses\%(Filename)%(Extension)" />
    <!-- API base URL; the Development file is read only in Debug builds (see Services/AppSettings.cs). -->
    <EmbeddedResource Include="appsettings.json" />
    <EmbeddedResource Include="appsettings.Development.json" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <!-- Cleartext to 10.0.2.2 exists only in Debug: swap the release network security config for the debug one. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
    <AndroidResource Include="Platforms\Android\DebugResources\xml\network_security_config.xml"
                     Link="Platforms\Android\Resources\xml\network_security_config.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- FCM token and messages for urgent help (ADR-0008). Without google-services.json the app runs with push off. -->
    <PackageReference Include="Xamarin.Firebase.Messaging" />
  </ItemGroup>

  <!-- google-services.json is an owner secret: never committed (see patika/app/.gitignore), added on the build machine. -->
  <ItemGroup Condition="Exists('google-services.json')">
    <GoogleServicesJson Include="google-services.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Patika.App.Core/Patika.App.Core.csproj" />
  </ItemGroup>

</Project>
