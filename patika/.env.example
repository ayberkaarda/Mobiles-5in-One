# Local docker compose settings. Every key the code reads is listed in docs/ops/env.md; secrets come from the
# environment or a secret store and are never committed.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Patika=
Storage__Endpoint=http://localhost:9000
Storage__Bucket=patika-local
Storage__AccessKey=
Storage__SecretKey=
Jwt__Issuer=patika-local
Jwt__Audience=patika-local

# P-256 private key, PKCS#8 PEM or single-line base64, never committed
Jwt__SigningKey=
# Android OAuth client id used as the ID token audience
Google__ClientIds__0=
# IP or CIDR of the reverse proxy whose X-Forwarded-For is trusted (one hop); empty trusts no forwarded header
Network__TrustedProxies__0=
# Shared key between the Web admin console and the API for the forwarded client address (docker compose sets a
# local default; set a long random value anywhere else). The API also needs Network__BffAddress, the Web's IP.
Network__BffSharedKey=
# Network__BffAddress=

# Public base URL that signed upload and photo URLs point at (R2/MinIO endpoint reachable by clients).
# docker compose defaults it to http://10.0.2.2:9000 (Android emulator); use http://localhost:9000 for a host browser.
Storage__PublicEndpoint=
# Media: per-user daily upload quota, default 30 (left commented: an empty number breaks binding)
# Media__DailyQuota=
# Push: Firebase project id for FCM HTTP v1; empty falls back to a logging sender
Push__Fcm__ProjectId=
# Push: service-account JSON (single line) used to mint FCM access tokens
Push__Fcm__ServiceAccountJson=
# Cost guard: daily pushes (non-critical pause) and daily emails (all email pauses), defaults 5000 / 5000.
# The hard push cap for urgent sends is Push__CostGuard__CriticalDailyCap (default 20000).
# CostGuard__MaxPushesPerDay=
# CostGuard__MaxEmailsPerDay=
# Push__CostGuard__CriticalDailyCap=
# Resend API key for transactional email; empty means the unconfigured sender
Resend__ApiKey=
# Operator mailbox for Worker alerts (cost guard, stale backup); empty means log lines only
Ops__AlertEmail=
# backup.verify: the backup folder, or the S3 bucket/prefix with a list-only key; empty turns the check off
# Backup__Directory=
# Backup__S3Endpoint=
# Backup__S3Bucket=
# Backup__S3Prefix=db
# Backup__S3AccessKey=
# Backup__S3SecretKey=
