@{
    var current = Context.Request.Path.Value;
    string? Active(string path) => current == path ? "page" : null;
}
<nav aria-label="Yönetim menüsü">
    <a href="/admin" aria-current="@Active("/admin")">Moderasyon</a>
    @if (User.IsInRole("Admin"))
    {
        <a href="/admin/csv" aria-current="@Active("/admin/csv")">Bakım yeri içe aktar</a>
        <a href="/admin/kullanicilar" aria-current="@Active("/admin/kullanicilar")">Kullanıcılar</a>
        <a href="/admin/denetim" aria-current="@Active("/admin/denetim")">Denetim kaydı</a>
    }
</nav>
<div class="admin-session">
    <p>@(User.IsInRole("Admin") ? "Yönetici" : "Moderatör")</p>
    <form method="post" asp-area="Admin" asp-page="/Logout"><button class="admin-link" type="submit">Çıkış yap</button></form>
</div>
