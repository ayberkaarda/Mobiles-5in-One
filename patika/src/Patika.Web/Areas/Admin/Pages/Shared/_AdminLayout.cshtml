@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var current = Context.Request.Path.Value;
    string? Active(string path) => current == path ? "page" : null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] · Patika Yönetim</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin @(signedIn ? "admin-shell" : "admin-entry")">
    <a class="skip" href="#icerik">İçeriğe geç</a>
    @if (signedIn)
    {
        <aside class="admin-sidebar">
            <a href="/admin" aria-label="Patika yönetim"><img src="~/img/patika-lockup-kar.svg" alt="Patika" width="120" height="36" /></a>
            <p>Yönetim alanı</p>
            <nav aria-label="Yönetim menüsü">
                <a href="/admin" aria-current="@Active("/admin")">Moderasyon</a>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/admin/csv" aria-current="@Active("/admin/csv")">Bakım yeri içe aktar</a>
                    <a href="/admin/kullanicilar" aria-current="@Active("/admin/kullanicilar")">Kullanıcılar</a>
                    <a href="/admin/denetim" aria-current="@Active("/admin/denetim")">Denetim kaydı</a>
                }
            </nav>
            <div class="admin-session">
                <p>@(User.IsInRole("Admin") ? "Yönetici" : "Moderatör")</p>
                <form method="post" asp-area="Admin" asp-page="/Logout"><button class="admin-link" type="submit">Çıkış yap</button></form>
            </div>
        </aside>
    }
    <main id="icerik" class="admin-main">
        @if (Model is AdminPage adminPage)
        {
            @if (adminPage.Error is not null) { <p class="admin-alert" role="alert">@adminPage.Error</p> }
            @if (adminPage.Notice is not null) { <p class="admin-notice" role="status">@adminPage.Notice</p> }
        }
        @RenderBody()
    </main>
</body>
</html>

