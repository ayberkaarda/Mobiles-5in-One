@{
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] · Patika Yönetim</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin @(signedIn ? "admin-shell" : "admin-entry")">
    <a class="skip" href="#icerik">İçeriğe geç</a>
    @if (signedIn)
    {
        <aside class="admin-sidebar">
            <a href="/admin" aria-label="Patika yönetim"><img src="~/img/patika-lockup-kar.svg" alt="Patika" width="120" height="36" /></a>
            <p>Yönetim alanı</p>
            <div class="admin-desktop-menu">
                <partial name="_AdminMenu" />
            </div>
            <details class="admin-menu">
                <summary>Menü</summary>
                <partial name="_AdminMenu" />
            </details>
        </aside>
    }
    <main id="icerik" class="admin-main">
        @if (Model is AdminPage adminPage)
        {
            @if (adminPage.Error is not null) { <p class="admin-alert" role="alert">@adminPage.Error</p> }
            @if (adminPage.Notice is not null) { <p class="admin-notice" role="status">@adminPage.Notice</p> }
        }
        @RenderBody()
    </main>
</body>
</html>

