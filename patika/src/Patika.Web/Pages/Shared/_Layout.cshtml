@using Patika.Web.Routing
@inject TimeProvider Clock
@{
    var path = Context.Request.Path;
    string? Current(string section) => path.StartsWithSegments(section, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    var stations = Routes.Province("istanbul");
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <partial name="_SeoHead" />
    <meta name="theme-color" content="#F28C28" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/img/patika-icon-192.png" />
    <link rel="preload" href="~/fonts/nunito/Nunito-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/nunito-sans/NunitoSans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip" href="#icerik">İçeriğe geç</a>
    <header class="masthead">
        <div class="masthead__inner">
            <a class="masthead__logo" href="@Routes.Home" aria-label="Patika ana sayfa">
                <img src="~/img/patika-lockup.svg" alt="Patika" width="136" height="41" />
            </a>
            <nav class="masthead__nav" aria-label="Ana menü">
                <a href="@Routes.Adoptions" aria-current="@Current(Routes.Adoptions)">Sahiplendirme</a>
                <a href="@stations" aria-current="@Current("/istasyonlar")">İstasyonlar</a>
                <a href="@Routes.CarePlaces" aria-current="@(Current(Routes.CarePlaces) ?? Current("/bakim-yeri"))">Bakım yerleri</a>
                <a href="@Routes.Guides" aria-current="@Current(Routes.Guides)">Rehber</a>
                <a href="@Routes.Impact" aria-current="@Current(Routes.Impact)">Etki</a>
            </nav>
            <a class="button button--small masthead__app" href="@(Routes.Home)#uygulama">Android uygulaması</a>
        </div>
    </header>

    <main id="icerik">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer__inner">
            <div class="footer__brand">
                <img src="~/img/patika-lockup-kar.svg" alt="Patika" width="136" height="41" loading="lazy" />
                <p class="footer__tagline">Mahallenin patilerini birlikte koruyalım.</p>
                <p class="footer__promise">Konumun hiçbir zaman profilinde saklanmaz. Fotoğraflarının konum bilgisi telefonda silinir, sunucuya hiç gelmez.</p>
            </div>
            <nav class="footer__links" aria-label="Patika">
                <a href="@Routes.About">Hakkında</a>
                <a href="@Routes.Faq">Sık sorulanlar</a>
                <a href="@Routes.Guides">Rehber</a>
                <a href="@Routes.Impact">Etki</a>
                <a href="@Routes.Contact">İletişim</a>
            </nav>
            <nav class="footer__links" aria-label="Yasal">
                <a href="@Routes.Privacy">Gizlilik</a>
                <a href="@Routes.Kvkk">KVKK aydınlatma metni</a>
                <a href="@Routes.Terms">Kullanım koşulları</a>
                <a href="@Routes.DeleteAccount">Hesabımı sil</a>
            </nav>
            <p class="footer__legal">&copy; @TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), PublicText.Istanbul).Year Patika Topluluk Teknolojileri</p>
        </div>
    </footer>
</body>
</html>
