{
  "$description": "Patika design tokens. Single source for the web (wwwroot/css/tokens.css) and the Android app (Resources/Styles/Tokens.xaml). Edit this file, then run: dotnet run brand/tools/build-tokens.cs",
  "color": {
    "tekir": { "$type": "color", "$value": "#F28C28", "name": "Turuncu Tekir", "role": "Primary. The trail, primary actions, app icon field. Never as text on light surfaces." },
    "tekir-deep": { "$type": "color", "$value": "#A8520A", "name": "Tekir koyu", "role": "Orange text and icons on light surfaces (5.2:1 on kar)." },
    "tekir-soft": { "$type": "color", "$value": "#FDEBD8", "name": "Tekir açık", "role": "Tint behind food stations and selected states." },
    "kaldirim": { "$type": "color", "$value": "#3D3A36", "name": "Kaldırım Taşı", "role": "Text and dark surfaces (10.8:1 on kar)." },
    "kaldirim-soft": { "$type": "color", "$value": "#57534D", "name": "Kaldırım açık", "role": "Raised elements on dark surfaces." },
    "kar": { "$type": "color", "$value": "#FBFAF8", "name": "Kar Beyazı", "role": "Page surface." },
    "beyaz": { "$type": "color", "$value": "#FFFFFF", "name": "Beyaz", "role": "Raised surfaces: sheets, tags, inputs." },
    "kum": { "$type": "color", "$value": "#F2EEE8", "name": "Kum", "role": "Sunken surface: map blocks, quiet panels." },
    "cizgi": { "$type": "color", "$value": "#E2DDD6", "name": "Çizgi", "role": "Hairlines and streets on the map." },
    "nane": { "$type": "color", "$value": "#7BC8A4", "name": "Nane Yeşili", "role": "Secondary: water and health markers, fills only." },
    "nane-deep": { "$type": "color", "$value": "#2A7353", "name": "Nane koyu", "role": "Green text and health flags on light surfaces (5.5:1)." },
    "nane-soft": { "$type": "color", "$value": "#E3F3EB", "name": "Nane açık", "role": "Tint behind water stations and health flags." },
    "boncuk": { "$type": "color", "$value": "#2F6FED", "name": "Boncuk Mavisi", "role": "Links and street-name plates." },
    "boncuk-deep": { "$type": "color", "$value": "#2A62D6", "name": "Boncuk koyu", "role": "Body-size text links on light surfaces (5.3:1 on kar)." },
    "acil": { "$type": "color", "$value": "#D64545", "name": "Acil", "role": "Urgent help only. Fills and large text." },
    "acil-deep": { "$type": "color", "$value": "#B83232", "name": "Acil koyu", "role": "Urgent text on light surfaces (5.7:1)." },
    "acil-soft": { "$type": "color", "$value": "#FBE9E8", "name": "Acil açık", "role": "Tint behind urgent notices." },
    "sis": { "$type": "color", "$value": "#8C8781", "name": "Sis", "role": "Muted marks, disabled, decorative only (3.4:1)." },
    "sis-deep": { "$type": "color", "$value": "#6B6660", "name": "Sis koyu", "role": "Muted text (5.5:1 on kar)." },
    "sis-light": { "$type": "color", "$value": "#B5AFA8", "name": "Sis açık", "role": "Muted small text on Kaldırım surfaces (5.2:1)." }
  },
  "font": {
    "display": { "family": "Nunito", "weights": [700, 800], "files": ["Nunito-Bold.ttf", "Nunito-ExtraBold.ttf"], "role": "Headlines, names, counts, buttons." },
    "body": { "family": "Nunito Sans", "weights": [400, 600, 700], "files": ["NunitoSans-Regular.ttf", "NunitoSans-SemiBold.ttf", "NunitoSans-Bold.ttf"], "role": "Body text and interface labels on web and Android." },
    "numerals": "tabular-nums for counts, times and distances"
  },
  "size": {
    "caption": { "$type": "dimension", "$value": 13 },
    "small": { "$type": "dimension", "$value": 15 },
    "body": { "$type": "dimension", "$value": 17 },
    "lead": { "$type": "dimension", "$value": 20 },
    "h4": { "$type": "dimension", "$value": 22 },
    "h3": { "$type": "dimension", "$value": 28 },
    "h2": { "$type": "dimension", "$value": 36 },
    "h1": { "$type": "dimension", "$value": 48 },
    "display": { "$type": "dimension", "$value": 76 }
  },
  "leading": {
    "tight": { "$type": "number", "$value": 1.04 },
    "snug": { "$type": "number", "$value": 1.2 },
    "body": { "$type": "number", "$value": 1.55 }
  },
  "space": {
    "1": { "$type": "dimension", "$value": 4 },
    "2": { "$type": "dimension", "$value": 8 },
    "3": { "$type": "dimension", "$value": 12 },
    "4": { "$type": "dimension", "$value": 16 },
    "5": { "$type": "dimension", "$value": 24 },
    "6": { "$type": "dimension", "$value": 32 },
    "7": { "$type": "dimension", "$value": 48 },
    "8": { "$type": "dimension", "$value": 64 },
    "9": { "$type": "dimension", "$value": 96 },
    "10": { "$type": "dimension", "$value": 128 }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": 6 },
    "md": { "$type": "dimension", "$value": 12 },
    "lg": { "$type": "dimension", "$value": 24 },
    "pill": { "$type": "dimension", "$value": 999 }
  },
  "trail": {
    "dot": { "$type": "dimension", "$value": 6, "role": "Dot diameter of the dotted path." },
    "gap": { "$type": "dimension", "$value": 10, "role": "Gap between dots." }
  },
  "motion": {
    "quick": { "$type": "duration", "$value": 160 },
    "trail": { "$type": "duration", "$value": 1600, "role": "The single entrance animation: the trail draws itself once on first load." }
  }
}
