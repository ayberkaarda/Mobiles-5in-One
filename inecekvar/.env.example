# Local development values only; replace no value with a production credential.
# Copy to .env next to docker-compose.yml. See docs/ops/env.md for who reads each key.

# --- Consumed in Phase 0: Docker Compose reads these from .env (defaults shown) ---
# Host port of the PostgreSQL/PostGIS container.
INECEKVAR_PG_PORT=57432
# Host port of the Redis container.
INECEKVAR_REDIS_PORT=57379
# Host port of the Caddy web site (inecekvar.app stand-in).
INECEKVAR_WEB_PORT=57080
# Host port of the Caddy app site (PWA stand-in).
INECEKVAR_APP_PORT=57081
# Host port of the MinIO S3 API.
INECEKVAR_MINIO_PORT=57900
# Host port of the MinIO console.
INECEKVAR_MINIO_CONSOLE_PORT=57901
# Host port of the Mailpit SMTP sink.
INECEKVAR_MAIL_SMTP_PORT=57025
# Host port of the Mailpit web UI.
INECEKVAR_MAIL_UI_PORT=57825
# Local PostgreSQL password; local-dev-only.
INECEKVAR_DB_PASSWORD=inecekvar_local_dev
# Local MinIO root password; local-dev-only.
INECEKVAR_MINIO_PASSWORD=inecekvar_local_dev

# --- Read by the API settings class (app/core/settings.py, prefix INECEKVAR_) ---
# Required; local enables the compose defaults below and per-process random secrets and keys.
INECEKVAR_ENV=local
# Local PostgreSQL connection; password is local-dev-only.
INECEKVAR_DATABASE_URL=postgresql+asyncpg://inecekvar:inecekvar_local_dev@localhost:57432/inecekvar
# Local Redis connection; the local instance has no password.
INECEKVAR_REDIS_URL=redis://localhost:57379/0
# Local SMTP sink served by Mailpit (no TLS locally; production requires INECEKVAR_SMTP_USE_TLS=true).
INECEKVAR_SMTP_HOST=localhost
INECEKVAR_SMTP_PORT=57025
# Trusted proxy networks whose X-Real-IP header is honoured (a JSON list).
INECEKVAR_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
# Secrets have no example value: INECEKVAR_CSRF_SECRET, INECEKVAR_LOG_HASH_KEY and the ES256
# key pair (INECEKVAR_JWT_PRIVATE_KEY_PEM or _PATH, INECEKVAR_JWT_PUBLIC_KEY_PEM or _PATH) are
# created per process when INECEKVAR_ENV=local and must be provided in test and production.

# --- Planned for Phase 2: object storage, not read by the API yet ---
# Local S3-compatible MinIO endpoint.
S3_ENDPOINT_URL=http://localhost:57900
# Local MinIO bucket name.
S3_BUCKET=inecekvar-media
# Local MinIO access key.
S3_ACCESS_KEY_ID=inecekvar
# Local MinIO secret key; local-dev-only.
S3_SECRET_ACCESS_KEY=inecekvar_local_dev
