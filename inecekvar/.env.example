# Local development values only; replace no value with a production credential.
APP_ENV=local
# Local API listening address.
API_HOST=127.0.0.1
# Local API listening port.
API_PORT=8000
# Local PostgreSQL connection; password is local-dev-only.
DATABASE_URL=postgresql+asyncpg://inecekvar:local-dev-only@localhost:5432/inecekvar
# Local Redis connection; password is local-dev-only.
REDIS_URL=redis://:local-dev-only@localhost:6379/0
# Local S3-compatible MinIO endpoint.
S3_ENDPOINT_URL=http://localhost:9000
# Local MinIO bucket name.
S3_BUCKET=inecekvar-local
# Local MinIO access key.
S3_ACCESS_KEY_ID=local-dev-only
# Local MinIO secret key.
S3_SECRET_ACCESS_KEY=local-dev-only
# Local SMTP sink served by Mailpit.
SMTP_HOST=localhost
# Local Mailpit SMTP port.
SMTP_PORT=1025
# Local Caddy development HTTP address.
CADDY_HTTP_PORT=8080
# Local Caddy development HTTPS address.
CADDY_HTTPS_PORT=8443
