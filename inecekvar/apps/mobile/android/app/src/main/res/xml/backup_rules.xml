<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-0055: Android 11 and older (full backup format); same exclusions as data_extraction_rules. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
