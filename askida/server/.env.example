# Local development defaults for the docker-compose stack (askida/docker-compose.yml).
# Copy to .env; `php artisan key:generate` fills APP_KEY. Every password below is a
# local-only default; real deployments set their own values through the environment.

APP_NAME=Askida
APP_ENV=local
APP_KEY=
# Cipher of the encrypted columns (tax number, IBAN); the key stays 32 bytes.
APP_CIPHER=AES-256-GCM
APP_DEBUG=true
APP_URL=http://localhost:58080
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=askida
DB_USERNAME=askida
DB_PASSWORD=askida_local_dev

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Security: comma-separated lists; empty means none. TRUSTED_PROXIES lists proxies whose
# forwarded headers are honoured. The pay lists hold the payment provider hosts for /pay/*
# (frames, the checkout script bundle, its API calls); empty keeps the strict policy.
# Sample values from the provider's public documentation, NOT verified (no sandbox account):
#   SECURITY_CSP_FRAME_SRC_PAY=https://sandbox-cpp.iyzipay.com
#   SECURITY_CSP_SCRIPT_SRC_PAY=https://static.iyzipay.com,https://sandbox-static.iyzipay.com
#   SECURITY_CSP_CONNECT_SRC_PAY=https://sandbox-api.iyzipay.com
TRUSTED_PROXIES=
SECURITY_CSP_FRAME_SRC_PAY=
SECURITY_CSP_SCRIPT_SRC_PAY=
SECURITY_CSP_CONNECT_SRC_PAY=
SECURITY_CORS_ALLOWED_ORIGINS=https://askida.app
# Send HSTS even when the request does not look secure (TLS ended by a hop that is not in
# TRUSTED_PROXIES). Keep false when the edge proxy is trusted.
SECURITY_HSTS_FORCE=false

# Authentication: lockout window and failed-attempt threshold; token lifetime in minutes (30 days).
AUTH_LOCKOUT_MINUTES=15
AUTH_LOCKOUT_ATTEMPTS=10
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
# Sign in with Apple / Google: comma-separated client ids accepted as the identity token
# audience. Empty rejects every identity token.
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
# Breached password check (k-anonymity range API). Fails open with a warning when the
# service is unreachable; set false only for offline development.
BREACHED_PASSWORD_CHECK=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@askida.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage; locally the MinIO service (root user and password
# from docker-compose.yml). Buckets are created by the minio-init service.
AWS_ACCESS_KEY_ID=askida
AWS_SECRET_ACCESS_KEY=askida_local_dev
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_PRIVATE=askida-private
AWS_BUCKET_PUBLIC=askida-public
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Endpoint written into presigned upload URLs handed to devices, when the devices reach the
# store under another address than the server does (Android emulator: http://10.0.2.2:59000,
# a phone on the LAN: the host's address). Empty: URLs use AWS_ENDPOINT.
AWS_PUBLIC_ENDPOINT=

# Pepper for redemption code hashes (at least 32 characters). The value below is a plain-word
# local development default and not a secret; every other environment sets its own long
# random value (an empty pepper stops the boot outside local and testing, and this exact
# value is refused outside local and testing).
HOOK_CODE_PEPPER=local-development-pepper-not-a-secret
# Minutes a reserved unit is held before it returns to the pool.
HOOK_RESERVATION_MINUTES=10

# Payment provider: fake (local and tests) or iyzico.
PAYMENT_PROVIDER=fake
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Platform commission in basis points (500 = 5%). A SAMPLE rate for demonstration; the real rate is a business decision.
COMMISSION_BPS=500
# Webhooks older than this many seconds are rejected as stale.
WEBHOOK_MAX_AGE_SECONDS=300
# Recipient of reconciliation mismatch and fraud alerts.
FINANCE_ALERT_EMAIL=finance@example.test
# Fraud scan: redemptions per shop and hour, and the share of redemptions made by shop staff themselves.
FRAUD_MAX_REDEEMS_PER_HOUR=30
FRAUD_MAX_SELF_REDEEM_RATIO=0.5
# Comma-separated IPs or CIDR ranges allowed to reach /admin (empty = no restriction).
ADMIN_IP_ALLOWLIST=

# Attestation driver: fake or real. The app refuses fake in production-like environments.
ATTESTATION_DRIVER=fake
# Device attestation (left empty locally; the attestation checks are simulated there).
PLAY_INTEGRITY_PROJECT=
# Android application id the integrity verdict must name.
PLAY_INTEGRITY_PACKAGE_NAME=
PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON=
APPLE_TEAM_ID=
APPLE_DEVICECHECK_KEY_ID=
APPLE_DEVICECHECK_P8=
# DeviceCheck endpoint: sandbox (development builds) or production.
APPLE_DEVICECHECK_ENVIRONMENT=sandbox

# Push transport: log (local) or a real transport; the log transport is refused in production.
PUSH_DRIVER=log
# Push deliveries allowed per hour across all users; above it deliveries are dropped with a warning.
PUSH_HOURLY_FANOUT_CAP=500

# Disk holding shop documents (never public).
FILESYSTEM_PRIVATE_DISK=private

# Include sample shops in public listings (honoured outside production only).
ALLOW_SAMPLE_SHOPS=true

SENTRY_LARAVEL_DSN=

VITE_APP_NAME="${APP_NAME}"
