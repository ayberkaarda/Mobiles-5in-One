# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Localization output, rebuilt by `flutter pub get` / `flutter gen-l10n`
/lib/l10n/gen/

# Per-flavor build configuration (env/example.json is the committed template)
/env/*.json
!/env/example.json

# Signing material never enters the repository
*.jks
*.keystore
key.properties

# Sources built by build_runner (tool/codegen.sh); never committed
*.g.dart
*.freezed.dart
*.drift.dart
/lib/**/*.mocks.dart
/test/**/*.mocks.dart
