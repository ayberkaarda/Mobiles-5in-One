<?xml version="1.0" encoding="utf-8"?>
<!-- Every build except the dev flavor: HTTPS only, system trust anchors
     only (no user-installed certificates). The dev flavor replaces this file
     with src/dev/res/xml/network_security_config.xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
