      ["borderStrong", "surface"],
      ["borderStrong", "surfaceRaised"],
      ["borderStrong", "surfaceSunken"],
      ["primary", "background"],
      ["primary", "surface"],
      ["primary", "surfaceRaised"],
      ["primary", "surfaceSunken"],
      ["focusRing", "background"],
      ["focusRing", "surface"],
      ["focusRing", "surfaceRaised"],
      ["focusRing", "surfaceSunken"],
      ["danger", "background"],
      ["danger", "surface"],
      ["danger", "surfaceRaised"],
      ["danger", "surfaceSunken"],
      ["accent", "background"],
      ["accent", "surface"],
      ["accent", "surfaceRaised"]
    ],
    "notValidForText": [
      {
        "scheme": "light",
        "foreground": "accent",
        "background": "background",
        "reason": "Ekmek Kabuğu is never a text colour; use accentText."
      },
      {
        "scheme": "light",
        "foreground": "surface",
        "background": "accent",
        "reason": "Un Beyazı text on a tag fails; labels on tags use onAccent."
      }
    ],
    "notValidForFill": [
      {
        "scheme": "light",
        "fill": "accent",
        "background": "surfaceSunken",
        "minimum": 3,
        "reason": "In light, accent tags never sit on the sunken surface; the counter band uses surface tags there."
      }
    ],
    "excludedFromNonText": {
      "secondary": "Quiet fill (about 1.2:1 on background by design); never a boundary."
    }
  },
