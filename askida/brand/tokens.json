  "elevation": {
    "rule": "Flat: surface steps and 1 px border. Only bottom sheets and dialogs get one shadow.",
    "sheet": {
      "light": {
        "y": 8,
        "blur": 24,
        "spread": 0,
        "color": "#2B2B2B29"
      },
      "dark": {
        "y": 8,
        "blur": 24,
        "spread": 0,
        "color": "#00000080"
      }
    }
  },
  "motion": {
