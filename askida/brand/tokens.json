    "easing": {
      "in": [0.22, 1, 0.36, 1],
      "out": [0.4, 0, 1, 1]
    },
    "properties": ["transform", "opacity"],
    "reducedMotion": "Durations 0, fades at most fast (120 ms), the tag renders in place."
  }
