<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  ZAP context for the Cetele API scan (zap-api-scan.py -n api-context.xml). It holds no credential:
  the Authorization header is minted at run time and handed to ZAP through the
  ZAP_AUTH_HEADER_VALUE environment variable (see ops/zap/run-zap.sh).
  Scope: the scan host on any local port (zap-api-scan.py starts the active scan from the site
  root, so the root must be in the context). Excluded, each because it would damage the scan
  itself, not to hide a finding:
    - /v1/auth/logout and /v1/auth/refresh: they revoke or rotate the credential used by the run;
    - /v1/me/deletion and /v1/shops/{id}/deletion (any method): they schedule the deletion of the
      scan account and its shop, after which every later request would only see 401 or 404;
    - /actuator: not part of the OpenAPI document, scanned by the baseline checks of the
      deployment, not by the API scan.
-->
<configuration>
    <context>
        <name>cetele-api</name>
        <desc>Cetele JSON API (/v1) on the local compose stack</desc>
        <inscope>true</inscope>
        <incregexes>http://host\.docker\.internal:[0-9]+.*</incregexes>
        <excregexes>http://host\.docker\.internal:[0-9]+/v1/auth/logout.*</excregexes>
        <excregexes>http://host\.docker\.internal:[0-9]+/v1/auth/refresh.*</excregexes>
        <excregexes>http://host\.docker\.internal:[0-9]+/v1/me/deletion.*</excregexes>
        <excregexes>http://host\.docker\.internal:[0-9]+/v1/shops/[^/]+/deletion.*</excregexes>
        <excregexes>http://host\.docker\.internal:[0-9]+/actuator.*</excregexes>
        <tech>
            <include>Db.PostgreSQL</include>
            <include>Language.Java</include>
            <include>OS.Linux</include>
            <exclude>Db.CouchDB</exclude>
            <exclude>Db.Firebird</exclude>
            <exclude>Db.HypersonicSQL</exclude>
            <exclude>Db.IBM DB2</exclude>
            <exclude>Db.MariaDB</exclude>
            <exclude>Db.Microsoft Access</exclude>
            <exclude>Db.Microsoft SQL Server</exclude>
            <exclude>Db.MongoDB</exclude>
            <exclude>Db.MySQL</exclude>
            <exclude>Db.Oracle</exclude>
            <exclude>Db.SAP MaxDB</exclude>
            <exclude>Db.SQLite</exclude>
            <exclude>Db.Sybase</exclude>
            <exclude>Language.ASP</exclude>
            <exclude>Language.C</exclude>
            <exclude>Language.PHP</exclude>
            <exclude>Language.Python</exclude>
            <exclude>Language.Ruby</exclude>
            <exclude>OS.MacOS</exclude>
            <exclude>OS.Windows</exclude>
            <exclude>SCM.Git</exclude>
            <exclude>SCM.SVN</exclude>
            <exclude>WS.Apache</exclude>
            <exclude>WS.IIS</exclude>
        </tech>
        <urlparser>
            <class>org.zaproxy.zap.model.StandardParameterParser</class>
            <config>{"kvps":"&amp;","kvs":"=","struct":[]}</config>
        </urlparser>
        <postparser>
            <class>org.zaproxy.zap.model.StandardParameterParser</class>
            <config>{"kvps":"&amp;","kvs":"=","struct":[]}</config>
        </postparser>
        <authentication>
            <type>0</type>
        </authentication>
        <forceduser>-1</forceduser>
        <session>
            <type>0</type>
        </session>
        <authorization>
            <type>0</type>
            <basic>
                <header/>
                <body/>
                <logic>AND</logic>
                <code>-1</code>
            </basic>
        </authorization>
    </context>
</configuration>
