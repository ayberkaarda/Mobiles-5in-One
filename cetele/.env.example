# Cetele environment. Copy to cetele/.env for docker compose; never commit the copy.
# Every value here is a documented local development dummy or empty. Production values are set in
# the host environment only. Full reference, including the phase that starts reading each variable:
# docs/ops/env.md.

# Runtime (bound in Phase 0)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CETELE_PUBLIC_BASE_URL=http://127.0.0.1:60080

# PostgreSQL 16 (bound in Phase 0). The URL uses the compose service name; from the host use port 60432.
CETELE_DB_URL=jdbc:postgresql://postgres:5432/cetele
CETELE_DB_USERNAME=cetele
CETELE_DB_PASSWORD=cetele_local_dev

# S3-compatible storage: MinIO locally, Cloudflare R2 in production (bound in Phase 0).
CETELE_S3_ENDPOINT=http://minio:9000
CETELE_S3_REGION=auto
CETELE_S3_ACCESS_KEY=cetele
CETELE_S3_SECRET_KEY=cetele_local_dev
CETELE_S3_BUCKET_MEDIA=cetele-media
CETELE_S3_PATH_STYLE=true

# Mail (Mailpit locally: SMTP 60025 on the host, 1025 inside compose).
CETELE_MAIL_HOST=mailpit
CETELE_MAIL_PORT=1025
CETELE_MAIL_FROM=no-reply@cetele.app

# Auth secrets: OTP HMAC pepper and the ES256 JWT key pair (PEM). Empty here; created per environment.
CETELE_OTP_PEPPER=
CETELE_JWT_ES256_PRIVATE_KEY_PEM=
CETELE_JWT_ES256_PUBLIC_KEY_PEM=

# SMS: "fake" logs masked numbers and sends nothing; "netgsm" uses the Netgsm account below.
CETELE_SMS_PROVIDER=fake
CETELE_NETGSM_USERNAME=
CETELE_NETGSM_PASSWORD=
CETELE_NETGSM_MSGHEADER=
CETELE_SMS_DLR_SECRET=

# Google Play billing and real-time developer notifications.
CETELE_PLAY_PACKAGE_NAME=app.cetele.android
CETELE_PLAY_SERVICE_ACCOUNT_JSON=
CETELE_PLAY_RTDN_AUDIENCE=
CETELE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# Error reporting (empty disables Sentry).
SENTRY_DSN=
