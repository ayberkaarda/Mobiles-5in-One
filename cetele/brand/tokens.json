        "onSecondary": "#FAF7F0",
        "accent": "#E8712B",
        "onAccent": "#1A1A1A",
        "accentText": "#F4A06C",
        "debt": "#EB6F60",
        "onDebt": "#0E1325",
        "debtText": "#EB6F60",
        "debtMark": "#EB6F60",
        "payment": "#5CC08A",
        "onPayment": "#0E1325",
        "paymentText": "#5CC08A",
        "paymentMark": "#2E8B57",
        "error": "#EB6F60",
        "onError": "#0E1325",
        "errorText": "#EB6F60",
        "focusRing": "#E8712B",
        "overlay": "#000000B3"
      }
    },
    "roles": {
      "background": "Window/page background behind cards and lists",
      "surface": "Default container (cards, list rows, top bar)",
      "surfaceRaised": "Dialogs, bottom sheets, menus",
      "surfaceSunken": "Text fields, the running-total band",
      "text": "All body copy",
      "textMuted": "Secondary lines, timestamps, helper text",
      "border": "Decorative hairline between rows; never the only boundary of a control",
      "borderStrong": "Outlines that identify a control (text field, outlined button)",
      "primary": "Main buttons, selected navigation item, app bar accents",
      "onPrimary": "Labels and icons on primary",
      "primaryText": "Links and emphasised text on surfaces",
      "secondary": "Quiet fill: chips, selected rows, tonal buttons",
      "onSecondary": "Labels on secondary",
      "accent": "The one CTA per screen (\"Borç yaz\", \"Tahsilat al\" FAB); never a text colour",
      "onAccent": "Label on accent (always Mürekkep)",
      "accentText": "Orange-family text on surfaces",
      "debt": "Fill for debt actions and badges",
      "onDebt": "Label on debt",
      "debtText": "Debt amounts and the outstanding balance on surfaces",
      "debtMark": "Non-text debt indicator (dot, bar, chart)",
      "payment": "Fill for payment actions and badges",
      "onPayment": "Label on payment",
      "paymentText": "Payment amounts on surfaces",
      "paymentMark": "Non-text paid/settled indicator (dot, bar, chart)",
      "error": "Material error fill (validation); same values as debt, there is one red",
      "onError": "Label on error",
      "errorText": "Validation messages on surfaces",
      "focusRing": "Keyboard/switch-access focus outline",
      "overlay": "Scrim behind dialogs and sheets (#RRGGBBAA)"
    }
  },
  "contrast": {
    "textMinimum": 4.5,
    "nonTextMinimum": 3,
    "schemes": ["light", "dark"],
    "pairs": [
      ["text", "background"],
      ["text", "surface"],
      ["text", "surfaceRaised"],
      ["text", "surfaceSunken"],
      ["textMuted", "background"],
      ["textMuted", "surface"],
      ["textMuted", "surfaceRaised"],
      ["textMuted", "surfaceSunken"],
      ["primaryText", "background"],
      ["primaryText", "surface"],
      ["primaryText", "surfaceRaised"],
      ["primaryText", "surfaceSunken"],
      ["accentText", "background"],
      ["accentText", "surface"],
      ["accentText", "surfaceRaised"],
      ["accentText", "surfaceSunken"],
      ["debtText", "background"],
      ["debtText", "surface"],
      ["debtText", "surfaceRaised"],
      ["debtText", "surfaceSunken"],
      ["paymentText", "background"],
      ["paymentText", "surface"],
      ["paymentText", "surfaceRaised"],
      ["paymentText", "surfaceSunken"],
      ["errorText", "background"],
      ["errorText", "surface"],
      ["errorText", "surfaceRaised"],
      ["errorText", "surfaceSunken"],
      ["onPrimary", "primary"],
      ["onSecondary", "secondary"],
      ["text", "secondary"],
      ["textMuted", "secondary"],
      ["onAccent", "accent"],
      ["onDebt", "debt"],
      ["onPayment", "payment"],
      ["onError", "error"]
    ],
    "nonTextPairs": [
      ["borderStrong", "background"],
      ["borderStrong", "surface"],
      ["borderStrong", "surfaceRaised"],
      ["borderStrong", "surfaceSunken"],
      ["primary", "background"],
      ["primary", "surface"],
      ["primary", "surfaceRaised"],
      ["primary", "surfaceSunken"],
      ["focusRing", "background"],
      ["focusRing", "surface"],
      ["focusRing", "surfaceRaised"],
      ["focusRing", "surfaceSunken"],
      ["debtMark", "background"],
      ["debtMark", "surface"],
      ["debtMark", "surfaceRaised"],
      ["debtMark", "surfaceSunken"],
      ["paymentMark", "background"],
      ["paymentMark", "surface"],
      ["paymentMark", "surfaceRaised"],
      ["paymentMark", "surfaceSunken"],
      ["debt", "surface"],
      ["payment", "surface"],
      ["accent", "surfaceRaised"]
    ],
    "notValidForText": [
      {
        "scheme": "light",
        "foreground": "accent",
        "background": "surface",
        "reason": "Çentik Turuncu on Kâğıt is a fill or a mark, never text; use accentText."
      },
      {
        "scheme": "light",
        "foreground": "surface",
        "background": "accent",
        "reason": "Kâğıt labels on the orange CTA fail; the label is onAccent (Mürekkep)."
      },
      {
        "scheme": "light",
        "foreground": "surfaceRaised",
        "background": "accent",
        "reason": "White labels on the orange CTA fail as well."
      },
      {
        "scheme": "light",
        "foreground": "paymentMark",
        "background": "surface",
        "reason": "Ödendi Yeşili is a mark colour; payment amounts use paymentText (Ödendi Koyu)."
      },
      {
        "scheme": "light",
        "foreground": "surfaceRaised",
        "background": "paymentMark",
        "reason": "White on Ödendi Yeşili fails; payment buttons use the payment role (Ödendi Koyu)."
      },
      {
        "scheme": "light",
        "foreground": "debtMark",
        "background": "surfaceSunken",
        "reason": "Borç Kırmızısı as text on the sunken surface fails; debt amounts use debtText."
      },
      {
        "scheme": "light",
        "foreground": "borderStrong",
        "background": "background",
        "reason": "Kurşun as text on the page background fails; muted text uses textMuted (Kurşun Koyu)."
      },
      {
        "scheme": "dark",
        "foreground": "paymentMark",
        "background": "surface",
        "reason": "Ödendi Yeşili text on the dark surface fails; use paymentText (Ödendi Açık)."
      },
      {
        "scheme": "dark",
        "foreground": "text",
        "background": "accent",
        "reason": "Kâğıt labels on the orange CTA fail in dark too; the label stays Mürekkep."
      }
    ],
    "notValidForFill": [
      {
        "scheme": "light",
        "fill": "accent",
        "background": "background",
        "minimum": 3,
        "reason": "The orange CTA is identified by its Mürekkep label, not by its edge; never use accent as the only boundary or indicator on the light page."
      },
      {
        "scheme": "light",
        "fill": "accent",
        "background": "surface",
        "minimum": 3,
        "reason": "Same on Kâğıt: accent is not a non-text indicator there (2.87:1)."
      },
      {
        "scheme": "light",
        "fill": "accent",
        "background": "surfaceSunken",
        "minimum": 3,
        "reason": "Same on the sunken surface."
      }
    ],
    "excludedFromNonText": {
      "secondary": "Quiet fill by design (about 1.1:1 on surface); never a boundary.",
      "border": "Decorative hairline; borderStrong carries the boundary."
    }
  },
