{
  "name": "cetele-brand-tokens",
  "version": "1.0.0",
  "concept": "A tally stick on ledger paper: four vertical notches inside a large Ç whose cedilla is the fifth, diagonal notch. Defter Lacivert ink on Kâğıt; Çentik Turuncu marks the one action that matters on a screen.",
  "color": {
    "palette": {
      "defterLacivert": {
        "value": "#1E2A5A",
        "name": "Defter Lacivert",
        "derived": false,
        "use": "light primary and primaryText, dark onPrimary, app icon background"
      },
      "centikTuruncu": {
        "value": "#E8712B",
        "name": "Çentik Turuncu",
        "derived": false,
        "use": "accent/CTA fill in both schemes, dark focus ring, the cedilla in the mark and wordmark; never text on light surfaces"
      },
      "kagit": {
        "value": "#FAF7F0",
        "name": "Kâğıt",
        "derived": false,
        "use": "light surface, light onPrimary, dark text, logo strokes on the app icon"
      },
      "murekkep": {
        "value": "#1A1A1A",
        "name": "Mürekkep",
        "derived": false,
        "use": "light text, onAccent in both schemes, adaptive monochrome layer"
      },
      "odendiYesili": {
        "value": "#2E8B57",
        "name": "Ödendi Yeşili",
        "derived": false,
        "use": "paymentMark (non-text: status dots, paid bars) in both schemes; not valid for text or as a fill behind text (see contrast)"
      },
      "borcKirmizisi": {
        "value": "#C0392B",
        "name": "Borç Kırmızısı",
        "derived": false,
        "use": "light debt and error fill (white label), light debtMark"
      },
      "kursun": {
        "value": "#6B7280",
        "name": "Kurşun",
        "derived": false,
        "use": "borderStrong in both schemes; as text only on surface and surfaceRaised in light (textMuted uses Kurşun Koyu)"
      },
      "kagitGolge": {
        "value": "#F3EEE3",
        "name": "Kâğıt Gölge",
        "derived": true,
        "use": "light background (the page under the cards)"
      },
      "white": {
        "value": "#FFFFFF",
        "name": "White",
        "derived": true,
        "use": "light surfaceRaised, light onDebt, onPayment and onError"
      },
      "kagitSunken": {
        "value": "#EAE3D4",
        "name": "Kâğıt Sunken",
        "derived": true,
        "use": "light surfaceSunken (inputs, totals band)"
      },
      "kursunKoyu": {
        "value": "#575D69",
        "name": "Kurşun Koyu",
        "derived": true,
        "use": "light textMuted (Kurşun is 4.18:1 on the light background)"
      },
      "cizgi": {
        "value": "#E0D8C7",
        "name": "Çizgi",
        "derived": true,
        "use": "light border (decorative hairline, never the only boundary)"
      },
      "lacivertSoluk": {
        "value": "#E2E5EF",
        "name": "Lacivert Soluk",
        "derived": true,
        "use": "light secondary (quiet fill: chips, selected rows)"
      },
      "centikKoyu": {
        "value": "#A84716",
        "name": "Çentik Koyu",
        "derived": true,
        "use": "light accentText and light focus ring"
      },
      "borcKoyu": {
        "value": "#A8301F",
        "name": "Borç Koyu",
        "derived": true,
        "use": "light debtText and errorText (Borç Kırmızısı is 4.26:1 on the sunken surface)"
      },
      "odendiKoyu": {
        "value": "#24704A",
        "name": "Ödendi Koyu",
        "derived": true,
        "use": "light payment fill (white label) and paymentText"
      },
      "gece": {
        "value": "#0E1325",
        "name": "Gece",
        "derived": true,
        "use": "dark background, dark onDebt, onPayment and onError"
      },
      "geceSurface": {
        "value": "#151B31",
        "name": "Gece Surface",
        "derived": true,
        "use": "dark surface"
      },
      "geceRaised": {
        "value": "#1D2440",
        "name": "Gece Raised",
        "derived": true,
        "use": "dark surfaceRaised"
      },
      "geceSunken": {
        "value": "#090D1B",
        "name": "Gece Sunken",
        "derived": true,
        "use": "dark surfaceSunken"
      },
      "geceMuted": {
        "value": "#A7AEBF",
        "name": "Gece Muted",
        "derived": true,
        "use": "dark textMuted"
      },
      "geceCizgi": {
        "value": "#2A3250",
        "name": "Gece Çizgi",
        "derived": true,
        "use": "dark border"
      },
      "geceSecondary": {
        "value": "#262E4D",
        "name": "Gece Secondary",
        "derived": true,
        "use": "dark secondary (quiet fill)"
      },
      "lacivertAcik": {
        "value": "#AFBBEB",
        "name": "Lacivert Açık",
        "derived": true,
        "use": "dark primary and primaryText"
      },
      "centikAcik": {
        "value": "#F4A06C",
        "name": "Çentik Açık",
        "derived": true,
        "use": "dark accentText"
      },
      "borcAcik": {
        "value": "#EB6F60",
        "name": "Borç Açık",
        "derived": true,
        "use": "dark debt, debtText, debtMark and error roles"
      },
      "odendiAcik": {
        "value": "#5CC08A",
        "name": "Ödendi Açık",
        "derived": true,
        "use": "dark payment fill and paymentText"
      },
      "overlayLight": {
        "value": "#0E132599",
        "name": "Overlay Light",
        "derived": true,
        "use": "light scrim (Gece 60 %, alpha last)"
      },
      "overlayDark": {
        "value": "#000000B3",
        "name": "Overlay Dark",
        "derived": true,
        "use": "dark scrim (black 70 %, alpha last)"
      }
