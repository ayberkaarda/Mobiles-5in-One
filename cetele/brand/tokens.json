    "chip": 8,
    "button": 12,
    "input": 12,
    "card": 16,
    "row": 12,
    "sheet": 24,
    "dialog": 24,
    "fab": 16,
    "avatar": 9999
  },
  "shape": {
    "rule": "Material 3 shape scale fed from radius.",
    "extraSmall": 8,
    "small": 12,
    "medium": 16,
    "large": 24,
    "extraLarge": 28
  },
  "stroke": {
    "border": 1,
    "focus": 2,
    "focusOffset": 2,
    "divider": 1
  },
  "elevation": {
    "rule": "Flat ledger paper: surface steps plus a 1 dp border. Only sheets, dialogs and the FAB cast a shadow.",
    "levels": {
      "flat": 0,
      "fab": 6,
      "sheet": 8
    },
    "shadow": {
      "light": {
        "y": 4,
        "blur": 16,
        "spread": 0,
        "color": "#0E132529"
      },
      "dark": {
        "y": 4,
        "blur": 16,
        "spread": 0,
        "color": "#00000080"
      }
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "short": 100,
      "medium": 200,
      "long": 300,
      "emphasized": 450
    },
    "easing": {
      "standard": [0.2, 0, 0, 1],
      "emphasizedDecelerate": [0.05, 0.7, 0.1, 1],
      "emphasizedAccelerate": [0.3, 0, 0.8, 0.15]
    },
    "properties": ["transform", "opacity"],
    "reducedMotion": "When animations are off (Settings > Accessibility, or ANIMATOR_DURATION_SCALE 0) all durations are 0 and a new ledger entry appears in place."
  }
}
