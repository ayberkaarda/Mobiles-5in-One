{
  "name": "@kadro/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Kadro iOS and Android app (Expo, Expo Router).",
  "license": "UNLICENSED",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "expo": "57.0.26",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.20",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
