# Kadro environment variables.
#
# Copy to `.env` at the repository root for local development:  cp .env.example .env
# Every value below is a documented local-development dummy, except the signing keys, CSRF secret
# and hash secret, which are left empty and generated per machine (see below). Real values for
# preview and production live in the hosting provider's secret store, never in the repository.
#
# Validation lives in packages/config/src (schema.ts for web + worker, mobile-schema.ts for the
# mobile build); packages/config is the only module that reads process.env. An empty value is
# treated as unset.
# Apps fail fast at boot when a required key is missing or invalid. When a schema gains a key,
# this file gains the same key in the same change.

# ---------------------------------------------------------------------------
# Shared (web + worker)
# ---------------------------------------------------------------------------

# development | test | production. Must be `production` when APP_ENV is preview or production.
NODE_ENV=development

# local | preview | production
APP_ENV=local

# Build identifier reported by GET /api/v1/health. CI sets the git commit SHA.
BUILD_SHA=local

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL 16 connection URL for host-side processes (`pnpm dev`, migrations, tests). Locally it
# is the compose superuser, which may assume any role. Inside docker compose the web and worker
# containers override it with the login roles below. In preview/production the web login must be
# a member of kadro_app and the worker login a member of kadro_worker (migration 0010).
DATABASE_URL=postgres://kadro:kadro@localhost:5432/kadro

# ---------------------------------------------------------------------------
# Web + API (apps/web)
# ---------------------------------------------------------------------------

# Canonical web origin: access-token issuer and the only origin allowed to send credentials.
# The worker builds email links on it as well. Outside local it must be a non-loopback https://
# origin (production: https://kadro.app).
WEB_ORIGIN=http://localhost:3000

# Comma-separated browser origins allowed by CORS. Exact origins only (no wildcard, no path);
# must include WEB_ORIGIN; https:// only outside local
# (production: https://kadro.app,https://www.kadro.app).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ES256 (EC P-256) key pair that signs and verifies access tokens, as PEM; line breaks may be
# written as \n inside a double-quoted value. Intentionally empty here: no key material is ever
# committed. Generate local values with
#   pnpm --silent --filter @kadro/config secrets:generate
# and paste the printed lines over these keys. The web app refuses to start while they are empty.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# HMAC key for signed double-submit CSRF tokens: at least 43 base64url characters (256 bits).
# Printed by the same secrets:generate command.
CSRF_SECRET=

# HMAC key for keyed hashes of rate-limit bucket keys (IP, email) and audit_logs.ip_hash: at least
# 43 base64url characters (256 bits), different from CSRF_SECRET. Empty here on purpose; printed
# by the same secrets:generate command.
HASH_SECRET=

# Token and session lifetimes in seconds.
# Access JWT: 60..3600, default 900 (15 min). Refresh token: 86400..7776000, default 2592000
# (30 days), must exceed the access lifetime. Web session (rolling): 3600..2592000, default 604800.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_TTL_SECONDS=604800

# Web cookie names. Must use the __Host- prefix (Secure, Path=/, no Domain) and differ.
SESSION_COOKIE_NAME=__Host-kadro_session
CSRF_COOKIE_NAME=__Host-kadro_csrf

# Accepted `aud` values for Sign in with Apple (bundle id and/or services id), comma-separated.
APPLE_AUDIENCES=app.kadro.mobile

# Accepted `aud` values for Google ID tokens (iOS, Android and web OAuth client ids),
# comma-separated. The local value below is a syntactically valid dummy that matches no client.
GOOGLE_CLIENT_IDS=100000000000-kadrolocaldevelopment.apps.googleusercontent.com

# Client IP resolution for rate limiting. The address is read only from CLIENT_IP_HEADER
# (x-forwarded-for | x-real-ip | cf-connecting-ip). Hops inside TRUSTED_PROXY_CIDRS
# (comma-separated addresses or CIDR ranges) are skipped from the right; the first remaining
# address is the client. Empty trusts only the edge proxy (Caddy) that sets the header.
CLIENT_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Auth endpoint rate limit (login, register, forgot, reset, verify-email, apple, google):
# requests per window, applied per IP and per email. Spec defaults: 5 per 900 s.
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
# Progressive delay: starts after this many failures (<= RATE_LIMIT_AUTH_MAX), grows by the
# step in milliseconds per further failure.
RATE_LIMIT_AUTH_DELAY_AFTER_FAILURES=3
RATE_LIMIT_AUTH_DELAY_STEP_MS=500
# auth/refresh limit per refresh-token family.
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900

# Uploads (ADR-0030). The web app presigns PUTs into R2_INCOMING_BUCKET with R2_ENDPOINT,
# R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY (the keys are listed in the worker section below; in
# preview and production the web key may only PutObject into the incoming bucket and lives in the
# hosting provider's secret store). Locally the four keys may be left out together; presigning
# then answers 503. MEDIA_PUBLIC_BASE_URL is the public address of the media bucket: avatarUrl and
# badgeUrl are this value plus the stored key. It must be https:// everywhere (the API contract
# requires it): required outside local (non-loopback), optional locally where empty means every
# image URL is null. To serve local media over https, put a TLS proxy with a locally trusted
# certificate in front of the storage service and set, for example,
# MEDIA_PUBLIC_BASE_URL=https://localhost:9443/kadro-media (see docs/ops/worker.md).
# R2_ENDPOINT below may stay plain http on loopback; it is a server-side connection only.
MEDIA_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Worker (apps/worker)
# ---------------------------------------------------------------------------

# Outbound email (verification, password reset, account notices): log | resend (ADR-0029).
# `log` writes the rendered message, links included, to the log and is accepted only when
# APP_ENV=local. Preview and production must use `resend` with RESEND_API_KEY (re_...), which
# lives in the hosting provider's secret store. EMAIL_FROM is `address` or `Name <address>`.
# The web app reads the same three keys until it enqueues `email.send` instead of sending itself.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM=Kadro <bildirim@kadro.app>

# Push notifications: log | expo (ADR-0031). `log` writes the notification to the worker log and
# is accepted only when APP_ENV=local. `expo` requires EXPO_ACCESS_TOKEN (Expo enhanced push
# security), kept in the hosting provider's secret store.
PUSH_TRANSPORT=log
EXPO_ACCESS_TOKEN=

# Global push sends per hour (1..100000, default 5000). Above it notifications are dropped and
# counted as `push_capped` (security checklist item 22).
PUSH_HOURLY_CAP=5000

# Object storage of the worker (ADR-0030, ADR-0032): S3-compatible endpoint (Cloudflare R2 in
# preview and production, a local MinIO container in development; see docs/ops/worker.md).
# The worker key reads and deletes the private incoming bucket and reads, writes and deletes the
# media bucket. Outside local the endpoint must be a non-loopback https:// origin and the key pair
# lives in the hosting provider's secret store. The two buckets must differ. The local values
# below are the documented credentials of the local MinIO container, not real keys.
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=kadro-local
R2_SECRET_ACCESS_KEY=kadro-local-storage
R2_INCOMING_BUCKET=kadro-uploads-incoming
R2_MEDIA_BUCKET=kadro-media

# ---------------------------------------------------------------------------
# Local PostgreSQL container (docker-compose.yml only)
# ---------------------------------------------------------------------------

POSTGRES_USER=kadro
POSTGRES_PASSWORD=kadro
POSTGRES_DB=kadro

# Passwords of the local login roles kadro_app_user (member of kadro_app, used by the web
# container) and kadro_worker_user (member of kadro_worker, used by the worker container). The
# `db-roles` compose service creates the logins and applies these values on every `up`. They are
# placed into a connection URL, so use URL-safe characters only ([A-Za-z0-9._~-]).
KADRO_APP_DB_PASSWORD=kadro_app_local
KADRO_WORKER_DB_PASSWORD=kadro_worker_local

# ---------------------------------------------------------------------------
# Mobile public values (apps/mobile). Compiled into the binary: never put secrets here.
# ---------------------------------------------------------------------------

# local | preview | production
EXPO_PUBLIC_APP_ENV=local

# Base URL of the web/API app. Physical devices need the machine's LAN address instead of
# localhost. Must start with https:// outside the local environment and must not contain
# credentials, a query string or a fragment.
EXPO_PUBLIC_API_URL=http://localhost:3000
