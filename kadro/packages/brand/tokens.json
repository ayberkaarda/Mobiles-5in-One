{
  "version": "1.0.0",
  "color": {
    "palette": {
      "pitchGreen": "#1B7F4B",
      "nightMatch": "#0E1A14",
      "chalkWhite": "#F4F6F0",
      "orangeBall": "#FF6B1A",
      "cardYellow": "#F2C230",
      "redCard": "#D7263D",
      "neutral": "#5B6B62",
      "white": "#FFFFFF",
      "neutralOnDark": "#A8B5AD"
    },
    "theme": {
      "light": {
        "background": "#F4F6F0",
        "surface": "#FFFFFF",
        "text": "#0E1A14",
        "textMuted": "#5B6B62",
        "primary": "#1B7F4B",
        "onPrimary": "#FFFFFF",
        "accent": "#FF6B1A",
        "onAccent": "#0E1A14",
        "warning": "#F2C230",
        "onWarning": "#0E1A14",
        "danger": "#D7263D",
        "onDanger": "#FFFFFF",
        "link": "#1B7F4B"
      },
      "dark": {
        "background": "#0E1A14",
        "surface": "#16251D",
        "text": "#F4F6F0",
        "textMuted": "#A8B5AD",
        "primary": "#1B7F4B",
        "onPrimary": "#FFFFFF",
        "accent": "#FF6B1A",
        "onAccent": "#0E1A14",
        "warning": "#F2C230",
        "onWarning": "#0E1A14",
        "danger": "#D7263D",
        "onDanger": "#FFFFFF",
        "link": "#F4F6F0"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": "Sora",
      "body": "Inter",
      "numeric": "Inter"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontFeature": {
      "numeric": "tabular-nums"
    },
    "scale": {
      "caption": { "family": "body", "size": 12, "lineHeight": 16, "weight": 500 },
      "footnote": { "family": "body", "size": 13, "lineHeight": 18, "weight": 400 },
      "label": { "family": "body", "size": 14, "lineHeight": 20, "weight": 600 },
      "body": { "family": "body", "size": 16, "lineHeight": 24, "weight": 400 },
      "bodyStrong": { "family": "body", "size": 16, "lineHeight": 24, "weight": 600 },
      "title3": { "family": "display", "size": 20, "lineHeight": 28, "weight": 600 },
      "title2": { "family": "display", "size": 24, "lineHeight": 32, "weight": 600 },
      "title1": { "family": "display", "size": 32, "lineHeight": 40, "weight": 700 },
      "display": { "family": "display", "size": 44, "lineHeight": 52, "weight": 700 },
      "score": {
        "family": "numeric",
        "size": 40,
        "lineHeight": 48,
        "weight": 600,
        "fontFeature": "tabular-nums"
      }
    }
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 20,
    "full": 9999
  },
  "contrast": {
    "minimumRatio": 4.5,
    "pairs": [
      { "theme": "light", "foreground": "text", "background": "background" },
      { "theme": "light", "foreground": "text", "background": "surface" },
      { "theme": "light", "foreground": "textMuted", "background": "background" },
      { "theme": "light", "foreground": "textMuted", "background": "surface" },
      { "theme": "light", "foreground": "onPrimary", "background": "primary" },
      { "theme": "light", "foreground": "onAccent", "background": "accent" },
      { "theme": "light", "foreground": "onWarning", "background": "warning" },
      { "theme": "light", "foreground": "onDanger", "background": "danger" },
      { "theme": "light", "foreground": "link", "background": "background" },
      { "theme": "light", "foreground": "danger", "background": "background" },
      { "theme": "dark", "foreground": "text", "background": "background" },
      { "theme": "dark", "foreground": "text", "background": "surface" },
      { "theme": "dark", "foreground": "textMuted", "background": "background" },
      { "theme": "dark", "foreground": "textMuted", "background": "surface" },
      { "theme": "dark", "foreground": "onPrimary", "background": "primary" },
      { "theme": "dark", "foreground": "onAccent", "background": "accent" },
      { "theme": "dark", "foreground": "onWarning", "background": "warning" },
      { "theme": "dark", "foreground": "onDanger", "background": "danger" },
      { "theme": "dark", "foreground": "link", "background": "background" },
      { "theme": "dark", "foreground": "warning", "background": "background" },
      { "theme": "dark", "foreground": "accent", "background": "background" }
    ]
  }
}
