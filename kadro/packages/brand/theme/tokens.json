  "theming": {
    "schemes": ["light", "dark"],
    "preferences": ["system", "light", "dark"],
    "defaultPreference": "system",
    "web": {
      "attribute": "data-theme",
      "cookie": "kadro-theme",
      "cookieMaxAgeDays": 365,
      "metaColorScheme": "light dark",
      "themeColor": { "light": "#F5F6F1", "dark": "#0C1611" }
    },
    "mobile": {
      "storageKey": "kadro.colorScheme",
      "labels": { "system": "Sistem", "light": "Açık", "dark": "Koyu" }
    }
  },
  "state": {
    "rsvp": {
      "in": { "fill": "primary", "on": "onPrimary", "text": "primaryText" },
      "maybe": { "fill": "warning", "on": "onWarning", "text": "text" },
      "out": { "fill": "danger", "on": "onDanger", "text": "dangerText" },
      "waitlist": {
        "fill": "surface",
        "on": "textMuted",
        "text": "textMuted",
        "outline": "borderStrong"
      },
      "locked": { "fill": "fillMuted", "on": "textMuted", "text": "textMuted", "icon": "lock" }
    },
    "match": {
      "draft": "textMuted",
      "open": "primaryText",
      "locked": "textMuted",
      "played": "text",
      "cancelled": "dangerText"
    },
    "chip": {
      "rest": { "fill": "fillMuted", "on": "text" },
      "selected": { "fill": "inverse", "on": "onInverse" }
    },
    "sample": { "fill": "warning", "on": "onWarning", "label": "ÖRNEK" },
    "verified": { "icon": "check", "color": "primaryText", "label": "Doğrulanmış" }
  },
