{
  "name": "@kadro/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas and inferred types shared by the API, web and mobile clients.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "openapi": "node --import ./scripts/source-resolver.mjs scripts/generate-openapi.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
