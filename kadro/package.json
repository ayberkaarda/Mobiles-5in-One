{
  "name": "kadro",
  "version": "0.1.0",
  "private": true,
  "description": "Kadro monorepo: Expo mobile app, Next.js web + API, pg-boss worker and shared packages.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=@kadro/web --filter=@kadro/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:dev": "turbo run dev --filter=@kadro/worker",
    "mobile:start": "pnpm --filter @kadro/mobile start",
    "db:up": "docker compose up -d postgres"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.8",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "lefthook": "2.1.15",
    "prettier": "3.9.9",
    "turbo": "2.11.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
